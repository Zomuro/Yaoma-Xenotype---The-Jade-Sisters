<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<FactionDef ParentName="FactionBase" Name="YaomaXenotype_NPCFactionBase"> <!-- Palace -->
		<defName>YaomaXenotype_Faction_Palace</defName>
		<label>yaoma palace</label>
		<description>A gathering of Yaoma in a stable community aimed at developing the area.\n\nThey regard themselves as envoys of an enigmatic being known as "Suffering", who gave them a mission to prepare humanity against the unknown.</description>
		<pawnsPlural>yaoma</pawnsPlural>
		<techLevel>Ultra</techLevel>
		<listOrderPriority>9</listOrderPriority> <!-- List below pirates and above Yaoma Cult -->		
		
		<settlementTexturePath>World/WorldObjects/DefaultSettlement</settlementTexturePath>
		<factionIconPath>World/WorldObjects/Expanding/YaomaPalace</factionIconPath>
		<colorSpectrum Inherit = "False">
			<li>(0, 0.659, 0.42)</li>
		</colorSpectrum>
		
		<factionNameMaker>YaomaXenotype_NamerFaction</factionNameMaker> <!-- Faction naming -->
		<settlementNameMaker>YaomaXenotype_NamerSettlement</settlementNameMaker>

		<requiredCountAtGameStart>1</requiredCountAtGameStart> <!-- Faction settings -->
		<maxCountAtGameStart>1</maxCountAtGameStart>
		<settlementGenerationWeight>1</settlementGenerationWeight>
		<canMakeRandomly>true</canMakeRandomly>
		<canSiege>true</canSiege>
		<canStageAttacks>true</canStageAttacks>
		<leaderTitle>sect master</leaderTitle>
		
		<requiredMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Proselytizer</li>
		</requiredMemes>
		<disallowedMemes>
			<li MayRequire="Ludeon.RimWorld.Ideology">Nudism</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Raider</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">PainIsVirtue</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Blindsight</li>
		</disallowedMemes>
		<disallowedPrecepts>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Disapproved</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Acceptable</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Honorable</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Abhorrent</li>
			<li MayRequire="Ludeon.RimWorld.Ideology">IdeoDiversity_Horrible</li>
		</disallowedPrecepts>
		<backstoryFilters>
			<li>
				<categories>
					<li>Offworld</li>
				</categories>
				<commonality>1</commonality>
			</li>
			<li>
				<categories>
					<li>YaomaXenotype_YaomaBackstory</li>
				</categories>
				<commonality>3</commonality>
			</li>
		</backstoryFilters>
		
		<visitorTraderKinds>
			<li>YaomaXenotype_Trader_Visitor_Standard</li>
		</visitorTraderKinds>
		<caravanTraderKinds>
			<li>YaomaXenotype_Trader_Caravan_Palace</li>
		</caravanTraderKinds>
		<baseTraderKinds>
			<li>YaomaXenotype_Trader_Base_Standard</li>
		</baseTraderKinds>
		<allowedArrivalTemperatureRange>
			<min>-50</min>
			<max>45</max>
		</allowedArrivalTemperatureRange>
		<maxPawnCostPerTotalPointsCurve>
			<points>
				<li>(0,50)</li>			<!-- disciples can come in -->
				<li>(1000, 300)</li>	<!-- elders can come in -->
				<li>(4000, 800)</li>	<!-- ancestors can come in -->
				<li>(8000, 2500)</li>	<!-- immortals can come in -->			
				<li>(10000, 10000)</li>
			</points>
		</maxPawnCostPerTotalPointsCurve>
		<raidLootMaker>OutlanderRaidLootMaker</raidLootMaker>
		
		<pawnGroupMakers> <!-- Creates the groups of pawns you might see in the following situations: -->
			<li>
				<kindDef>Combat</kindDef>
				<options>
					<YaomaXenotype_Palace_DiscipleOuter>5</YaomaXenotype_Palace_DiscipleOuter>
					<YaomaXenotype_Palace_SectLeader>0.1</YaomaXenotype_Palace_SectLeader>		
				</options>
			</li>
			<li>
				<kindDef>Peaceful</kindDef>
				<options>
					<YaomaXenotype_Palace_DiscipleOuter>5</YaomaXenotype_Palace_DiscipleOuter>
					<YaomaXenotype_Palace_SectLeader>0.1</YaomaXenotype_Palace_SectLeader>	
				</options>
			</li>
			<li>
				<kindDef>Trader</kindDef>
				<traders>
					<YaomaXenotype_Palace_Merchant>1</YaomaXenotype_Palace_Merchant>
				</traders>
				<carriers>
					<Muffalo>2</Muffalo>
					<Dromedary>2</Dromedary>
				</carriers>
				<guards>
					<YaomaXenotype_Palace_DiscipleOuter>5</YaomaXenotype_Palace_DiscipleOuter>				
				</guards>
			</li>
			<li>
				<kindDef>Settlement</kindDef>
				<options>
					<YaomaXenotype_Palace_Villager>20</YaomaXenotype_Palace_Villager>
					<YaomaXenotype_Palace_Guard>10</YaomaXenotype_Palace_Guard>
					<YaomaXenotype_Palace_DiscipleOuter>5</YaomaXenotype_Palace_DiscipleOuter>
					<YaomaXenotype_Palace_SectLeader>1</YaomaXenotype_Palace_SectLeader>						
				</options>
			</li>
		</pawnGroupMakers>
	</FactionDef>

</Defs>