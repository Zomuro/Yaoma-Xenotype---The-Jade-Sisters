<?xml version="1.0" encoding="utf-8" ?>
<Defs>
		
	<!-- Armor Damage Types -->
	<DamageDef> <!-- Stink -->
		<defName>YaomaXenotype_Damage_Stink</defName>
		<label>stink</label>
		<workerClass>YaomaCore.DamageWorker_AddGlobalFleshOnly</workerClass>
		<canInterruptJobs>false</canInterruptJobs>
		<makesBlood>false</makesBlood>
		<defaultDamage>1</defaultDamage>
		<hediff>YaomaXenotype_Hediff_OlfactoryOverload</hediff>
		<explosionCellFleck>BlastExtinguisher</explosionCellFleck>
		<explosionColorEdge>(0.537, 0.635, 0.012, 0.05)</explosionColorEdge>
		<harmsHealth>false</harmsHealth>
		<soundExplosion>Explosion_Smoke</soundExplosion>
		<combatLogRules>Damage_Smoke</combatLogRules>
		<makesAnimalsFlee>true</makesAnimalsFlee>
	</DamageDef>
	
	<!-- Weapon Damage Types -->
	<DamageDef ParentName = "Bomb"> <!-- Flashbomb -->
		<defName>YaomaXenotype_Damage_FlashBomb</defName>
		<label>flash bomb</label>
		
		<additionalHediffs>
			<li><hediff>YaomaXenotype_Hediff_Flashbang_Sight</hediff><severityFixed>1</severityFixed></li>
			<li><hediff>YaomaXenotype_Hediff_Flashbang_Hearing</hediff><severityFixed>1</severityFixed></li>
		</additionalHediffs>
		
		<buildingDamageFactorImpassable>1</buildingDamageFactorImpassable>
    <buildingDamageFactorPassable>1</buildingDamageFactorPassable>
    <plantDamageFactor>1</plantDamageFactor>
    <corpseDamageFactor>1</corpseDamageFactor>
		
		<soundExplosion>Explosion_Smoke</soundExplosion>
		<combatLogRules>Damage_Smoke</combatLogRules>
		<makesAnimalsFlee>true</makesAnimalsFlee>
	</DamageDef>

	<DamageDef ParentName="BluntBase"> <!-- Internal Trauma -->
    <defName>YaomaXenotype_Damage_MeleeInternalTrauma</defName>
		<label>internal trauma</label>
    <workerClass>YaomaCore.DamageWorker_Blunt_ScalingBodySize</workerClass>
		<defaultArmorPenetration>1</defaultArmorPenetration>
    <bluntInnerHitChance>1</bluntInnerHitChance>
		<bluntInnerHitDamageFractionToConvert>0.30~0.50</bluntInnerHitDamageFractionToConvert>
    <bluntInnerHitDamageFractionToAdd>0.2~0.35</bluntInnerHitDamageFractionToAdd>
  </DamageDef>
	
	<DamageDef ParentName="BluntBase"> <!-- Heavy Blunt -->
    <defName>YaomaXenotype_Damage_Smash</defName>
		<label>smash</label>
		<defaultArmorPenetration>1</defaultArmorPenetration>
    <buildingDamageFactor>10</buildingDamageFactor>
    <buildingDamageFactorImpassable>0.75</buildingDamageFactorImpassable>
  </DamageDef>
	
</Defs>
