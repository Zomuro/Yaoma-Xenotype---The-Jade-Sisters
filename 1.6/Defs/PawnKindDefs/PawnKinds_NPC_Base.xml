<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	  <!-- ============================ Yaoma Base ========================== -->

	<PawnKindDef Name="YaomaXenotype_PawnKind_Base" Abstract="True"> <!-- Civilian Base -->
		<race>Human</race>
		<invNutrition>2.55</invNutrition>
		<chemicalAddictionChance>0</chemicalAddictionChance>
		<apparelAllowHeadgearChance>0</apparelAllowHeadgearChance>
		<apparelTags>
			<li>IndustrialBasic</li>
			<li>YaomaCivilianApparel</li>
		</apparelTags>
		
		<initialWillRange>0~1</initialWillRange>
		<initialResistanceRange>10~12</initialResistanceRange>
		
		<xenotypeSet> <!-- set the default xenotype set -->
			<xenotypeChances>
				<YaomaXenotype_YaomaXenotype>1</YaomaXenotype_YaomaXenotype>
			</xenotypeChances>
		</xenotypeSet>
	</PawnKindDef>
	
	<PawnKindDef Name="YaomaXenotype_PawnKind_Military_Base" ParentName = "YaomaXenotype_PawnKind_Base" Abstract="True"> <!-- Military/Disciple Base -->
		<isFighter>true</isFighter>
		
		<gearHealthRange>
		  <min>0.7</min>
		  <max>1</max>
		</gearHealthRange>
		<apparelTags Inherit = "False"/>		
		<apparelAllowHeadgearChance>1</apparelAllowHeadgearChance>
		
		<requiredWorkTags>
			<li>Violent</li>
		</requiredWorkTags>		
		
		<initialWillRange>1~2</initialWillRange>
		<initialResistanceRange>15~16</initialResistanceRange>
	</PawnKindDef>
	
	<PawnKindDef Name="YaomaXenotype_PawnKind_Elder_Base" ParentName = "YaomaXenotype_PawnKind_Military_Base" Abstract="True"> <!-- Elder Base -->
		<gearHealthRange>
		  <min>0.9</min>
		  <max>1.4</max>
		</gearHealthRange>
		
		<initialWillRange>2~3</initialWillRange>
		<initialResistanceRange>18~20</initialResistanceRange>
	</PawnKindDef>
	
	<PawnKindDef Name="YaomaXenotype_PawnKind_Ancestor_Base" ParentName = "YaomaXenotype_PawnKind_Military_Base" Abstract="True"> <!-- Ancestor Base -->
		<gearHealthRange>
		  <min>1.1</min>
		  <max>1.6</max>
		</gearHealthRange>
		
		<initialWillRange>3</initialWillRange>
		<initialResistanceRange>20~23</initialResistanceRange>
	</PawnKindDef>
	
	<PawnKindDef Name="YaomaXenotype_PawnKind_Immortal_Base" ParentName = "YaomaXenotype_PawnKind_Military_Base" Abstract="True"> <!-- Immortal Base -->
		<gearHealthRange>
		  <min>1.3</min>
		  <max>1.9</max>
		</gearHealthRange>
		
		<initialWillRange>5</initialWillRange>
		<initialResistanceRange>30~34</initialResistanceRange>
	</PawnKindDef>

</Defs>
